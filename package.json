{
  "name": "veyr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Veyr is a decentralized community forum on GenLayer. Posts are moderated by validator LLM consensus inside an Intelligent Contract; verdicts and reputation live on-chain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:contract": ".venv/bin/pytest tests/direct -v",
    "test:integration": ".venv/bin/gltest tests/integration -v -s --network studionet",
    "deploy": "node scripts/deploy.mjs",
    "live-test": "node scripts/live-test.mjs"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
