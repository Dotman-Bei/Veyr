# ─────────────────────────────────────────────────────────────
# Frontend (exposed to the browser bundle by Vite — no secrets!)
# ─────────────────────────────────────────────────────────────

# GenLayer network name from genlayer-js/chains. Veyr targets Studionet.
# Allowed: studionet | localnet
VITE_GENLAYER_NETWORK=studionet

# Deployed Veyr Intelligent Contract address (printed by `npm run deploy`).
VITE_GENLAYER_CONTRACT_ADDRESS=

# Optional RPC override. Leave blank to use the official chain default
# (Studionet: https://studio.genlayer.com/api, chain id 61999).
VITE_GENLAYER_RPC_URL=

# Optional DEV-ONLY signing key for the browser when no wallet is connected.
# Never put a real/funded key here: anything VITE_* ships in the client bundle.
VITE_GENLAYER_ACCOUNT_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# Deployment / scripts (Node only — never prefixed with VITE_)
# ─────────────────────────────────────────────────────────────

# Private key that deploys the contract and runs the live smoke test.
GENLAYER_PRIVATE_KEY=

# Constructor argument: the community topic the moderators enforce.
MODERATION_TOPIC=GenLayer and blockchain development
